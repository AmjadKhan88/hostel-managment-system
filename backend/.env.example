# ==============================
# APP
# ==============================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=change_me_dev_cookie_secret

# ==============================
# DATABASE
# ==============================
MONGO_URI=mongodb://127.0.0.1:27017/hostel_management_dev

# ==============================
# AUTH / JWT
# (implemented on the Authentication day — placeholders defined now
#  so the config module has a single source of truth from day one)
# ==============================
JWT_ACCESS_SECRET=change_me_dev_access_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRY=7d

# ==============================
# REDIS / BULLMQ
# ==============================
REDIS_URL=redis://127.0.0.1:6379

# ==============================
# CLOUDINARY (file storage)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# AI PROVIDER (provider-independent — see src/ai)
# ==============================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ==============================
# LOGGING
# ==============================
LOG_LEVEL=info

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ==============================
# SUPER ADMIN SEED (used by `npm run seed:admin` only — not env-validated)
# ==============================
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ==============================
# EMAIL (Nodemailer/SMTP) — reminders skip sending if left blank
# Free option for testing: mailtrap.io (sandbox SMTP, no real emails sent)
# ==============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Hostel Management System

# ==============================
# WHATSAPP (Twilio) — reminders skip sending if left blank
# Get sandbox credentials free at twilio.com/console — the sandbox
# "from" number is usually whatsapp:+14155238886
# ==============================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=